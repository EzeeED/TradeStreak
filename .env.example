# Puerto del API
PORT=4000
# Subruta pública (compila la web con el mismo valor): dominio.com/app/dashboard
BASE_PATH=/app
# Obligatorio en producción: cadena aleatoria larga
JWT_SECRET=
# Ruta del archivo SQLite
DB_PATH=./server/data/tradestreak.db
# Conexión de cuentas MT5 por login/servidor vía https://metaapi.cloud
METAAPI_TOKEN=
METAAPI_REGION=new-york
