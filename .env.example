# Puerto del API
PORT=4000
# Obligatorio en producción: cadena aleatoria larga
JWT_SECRET=
# URL pública con la que el EA de MT5 llega a tu servidor (usa HTTPS en producción)
PUBLIC_URL=https://tradestreak.tudominio.com
# Ruta del archivo SQLite
DB_PATH=./server/data/tradestreak.db
# Opcional: conectar cuentas con login/contraseña/servidor vía https://metaapi.cloud
METAAPI_TOKEN=
METAAPI_REGION=new-york
